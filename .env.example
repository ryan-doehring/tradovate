# Copy to .env for local development. Never commit .env.

TRADING_MODE=dry_run
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=
TRADOVATE_CID=
TRADOVATE_SEC=
TRADOVATE_API_URL=https://demo.tradovateapi.com/v1

GOOGLE_SERVICE_ACCOUNT_JSON=
# Sheet ID from the spreadsheet URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=VP

DEFAULT_CONTRACTS=1
DEFAULT_CLOSENESS_FACTOR=0

# Flat and order-free from NEWS_BUFFER_MINUTES before red news until NEWS_REOPEN_MINUTES after.
NEWS_BUFFER_MINUTES=10
NEWS_REOPEN_MINUTES=30
NEWS_SCAN_START_HOUR=5
NEWS_SCAN_END_HOUR=17

# Flat and order-free inside this many minutes of the session close.
EOD_MINUTES_BEFORE_CLOSE=20
MIN_DAYS_TO_EXPIRY=14
TIMEZONE=America/Chicago

# Price feed: auto (tradovate probe -> sheet cell -> yahoo) | tradovate | sheet | yahoo
PRICE_SOURCE=auto
# Optional: a cell you keep updated with a live price, and optionally its timestamp.
SHEET_PRICE_CELL=
SHEET_PRICE_TIME_CELL=
# Never arm on a quote older than this.
MAX_PRICE_AGE_MINUTES=15
# Optional symbol overrides, e.g. ES:ES=F,MES:ES=F
YAHOO_PRICE_SYMBOLS=

# Order tags: new orders use TAG_PREFIX; orders carrying a LEGACY_TAG_PREFIXES tag
# are still recognised as ours and get migrated by cancel + re-place.
TAG_PREFIX=vp
LEGACY_TAG_PREFIXES=vp2026
