# Copy to .env for local development. Never commit .env.

TRADING_MODE=dry_run
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=
TRADOVATE_CID=
TRADOVATE_SEC=
TRADOVATE_API_URL=https://demo.tradovateapi.com/v1

GOOGLE_SERVICE_ACCOUNT_JSON=
# Sheet ID from the spreadsheet URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=VP

DEFAULT_CONTRACTS=1
NEWS_BUFFER_MINUTES=5
NEWS_REOPEN_MINUTES=30
EOD_MINUTES_BEFORE_CLOSE=5
MIN_DAYS_TO_EXPIRY=14
TIMEZONE=America/Chicago
